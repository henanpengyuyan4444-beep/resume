---
import { siteConfig } from "../config";
import "../styles/global.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const edu = siteConfig.education[0];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{siteConfig.name} · 简历（打印版）</title>
    <style is:global>
      @page {
        size: A4;
        margin: 11mm 12mm;
      }

      body {
        margin: 0;
        background: #fff !important;
        color: #111 !important;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
          "Microsoft YaHei", sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: visible !important;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }

      .rule {
        height: 1px;
        background: #dcdfe5;
      }

      h1,
      h2,
      h3,
      p,
      ul {
        margin: 0;
      }

      ul {
        padding: 0;
        list-style: none;
      }

      .avoid {
        break-inside: avoid;
      }

      @media screen {
        body {
          background: #eceef2;
        }

        .sheet {
          box-shadow: 0 20px 60px -30px rgba(0, 0, 0, 0.45);
          margin: 32px auto;
          max-width: 820px;
          padding: 40px 44px;
          background: #fff;
        }
      }

      @media print {
        .sheet {
          padding: 0;
          margin: 0;
          max-width: none;
          box-shadow: none;
        }
      }
    </style>
  </head>

  <body>
    <main class="sheet">
      <!-- 抬头 -->
      <header class="flex items-start justify-between gap-6">
        <div>
          <h1 class="text-[30px] font-bold leading-none tracking-[-0.02em]">
            {siteConfig.name}
          </h1>
          <p class="mt-2 text-[13.5px] font-semibold text-[#333]">
            全栈开发工程师 <span class="text-[#777]">/ AI 应用方向</span>
          </p>
        </div>
        <div class="mono mt-1 space-y-1 text-right text-[10.5px] leading-relaxed text-[#444]">
          <p>{siteConfig.phone}</p>
          <p>{siteConfig.social.email}</p>
          <p>{siteConfig.location} · 2026 届 · 随时到岗</p>
        </div>
      </header>

      <div class="rule mt-4"></div>

      <!-- 概述 -->
      <section class="avoid mt-4">
        <p class="text-[10px] leading-[1.75] text-[#333]">{siteConfig.aboutMe}</p>
      </section>

      <div class="mt-4 grid grid-cols-[1.62fr_1fr] gap-6">
        <!-- 左：经历 -->
        <section>
          <h2 class="mono text-[10px] uppercase tracking-[0.16em] text-[#8a919c]">
            Experience
          </h2>
          <div class="mt-2.5 space-y-3">
            {
              siteConfig.experience.map((job) => (
                <article class="avoid border-t border-[#e5e7ec] pt-2.5 first:border-0 first:pt-0">
                  <div class="flex flex-wrap items-baseline gap-x-2">
                    <h3 class="text-[11px] font-semibold">{job.title}</h3>
                    <span class="text-[10px] text-[#666]">{job.company}</span>
                    <span class="mono ml-auto text-[9px] text-[#8a919c]">{job.dateRange}</span>
                  </div>
                  <ul class="mt-1 space-y-0.5">
                    {job.bullets.map((b) => (
                      <li class="flex gap-1.5 text-[9.5px] leading-[1.6] text-[#3d434e]">
                        <span class="mt-[6px] h-[3px] w-[3px] shrink-0 rounded-full bg-[#9aa3b2]" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>

        <!-- 右：技能 / 教育 / 项目 -->
        <div class="space-y-4">
          <section class="avoid">
            <h2 class="mono text-[10px] uppercase tracking-[0.16em] text-[#8a919c]">Skills</h2>
            <ul class="mt-2 flex flex-wrap gap-1">
              {siteConfig.skills.map((s) => (
                <li class="rounded border border-[#e2e5ea] px-1.5 py-0.5 text-[9px] text-[#414855]">
                  {s}
                </li>
              ))}
            </ul>
          </section>

          <section class="avoid">
            <h2 class="mono text-[10px] uppercase tracking-[0.16em] text-[#8a919c]">
              Education
            </h2>
            <div class="mt-2">
              <p class="text-[10.5px] font-semibold">{edu.school}</p>
              <p class="mono mt-0.5 text-[9px] text-[#8a919c]">{edu.dateRange}</p>
              <p class="mt-1 text-[9.5px] text-[#3d434e]">{edu.degree}</p>
              <ul class="mt-1 space-y-0.5">
                {edu.achievements.map((a) => (
                  <li class="text-[9px] leading-[1.6] text-[#3d434e]">· {a}</li>
                ))}
              </ul>
            </div>
          </section>
        </div>
      </div>

      <!-- 项目 -->
      <section class="avoid mt-4">
        <h2 class="mono text-[10px] uppercase tracking-[0.16em] text-[#8a919c]">Projects</h2>
        <div class="mt-2 grid grid-cols-2 gap-x-5 gap-y-2.5">
          {
            siteConfig.projects.map((p) => (
              <article class="avoid">
                <h3 class="text-[10.5px] font-semibold leading-snug">{p.name}</h3>
                <p class="mt-0.5 text-[9px] leading-[1.6] text-[#3d434e]">{p.description}</p>
                <p class="mono mt-0.5 text-[8.5px] text-[#8a919c]">{p.skills.join(" · ")}</p>
              </article>
            ))
          }
        </div>
      </section>

      <div class="rule mt-5"></div>
      <p class="mono mt-2 text-[8px] text-[#9aa3b2]">
        {siteConfig.name} · 在线简历 {base ? "见个人主页" : ""} · 更新于 {new Date().toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}
      </p>
    </main>
  </body>
</html>
