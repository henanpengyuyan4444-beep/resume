---
import { siteConfig } from "../config";
const year = new Date().getFullYear();
---

<footer class="no-print border-t border-line py-10">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-2 px-6 text-[12px] text-dim sm:flex-row sm:items-center sm:justify-between lg:px-8"
  >
    <p>© {year} {siteConfig.name} · 全栈开发工程师</p>
    <p class="font-mono">
      Astro + Tailwind · 版式参考
      <a
        class="underline decoration-line underline-offset-4 transition-colors hover:text-muted"
        href="https://github.com/RyanFitzgerald/devportfolio"
        target="_blank"
        rel="noopener noreferrer">DevPortfolio</a
      >
    </p>
  </div>
</footer>
