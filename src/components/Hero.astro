---
import { siteConfig } from "../config";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const stack = [
  "Python",
  "FastAPI",
  "Go",
  "Vue 3",
  "TypeScript",
  "React",
  "Flutter",
  "PostgreSQL",
  "Redis",
  "Docker",
  "Kubernetes",
  "LLM",
];
---

<section
  id="top"
  class="hero relative isolate flex h-[100svh] min-h-[620px] w-full items-end overflow-hidden"
>
  <!-- 全屏照片 + 视差 -->
  <div class="hero-media absolute inset-0 -z-10">
    <img
      src={`${base}/portrait-hero.jpg`}
      alt="张雨在雪场，手持单板"
      width="1280"
      height="1706"
      fetchpriority="high"
      class="h-full w-full object-cover object-[62%_18%] lg:object-[82%_30%]"
    />
  </div>

  <!-- 左侧柔焦：让文字区干净，右边人物保持清晰 -->
  <div class="hero-blur absolute inset-0 -z-10"></div>

  <!-- 压暗：左侧保文字、底部接下一屏 -->
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(6,7,10,0.97)_0%,rgba(6,7,10,0.88)_32%,rgba(6,7,10,0.45)_58%,rgba(6,7,10,0.08)_82%,rgba(6,7,10,0)_100%)]"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(6,7,10,0.7)_0%,rgba(6,7,10,0)_28%,rgba(6,7,10,0)_58%,rgba(6,7,10,0.92)_100%)]"
  >
  </div>

  <!-- 文字区再加一层局部压暗，保证小字对比度 -->
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(78%_68%_at_12%_80%,rgba(6,7,10,0.92)_0%,rgba(6,7,10,0.62)_42%,rgba(6,7,10,0)_76%)]"
  >
  </div>

  <!-- 贴纸标签 -->
  <div
    class="absolute right-6 top-24 z-10 hidden rotate-3 rounded-lg border border-white/25 bg-black/35 px-3 py-2 font-mono text-[10.5px] tracking-[0.16em] text-white/80 backdrop-blur-md sm:right-10 sm:top-28 sm:block lg:right-16"
  >
    2026 · OPEN TO WORK
  </div>

  <div class="mx-auto w-full max-w-6xl px-6 pb-16 lg:px-8 lg:pb-20">
    <div class="hero-fade max-w-xl">
      <p class="font-mono text-[11px] tracking-[0.24em] text-white/60">
        39.9°N 116.4°E · BEIJING
      </p>

      <h1
        class="mt-3 text-[clamp(3.6rem,15vw,9rem)] font-extrabold leading-[0.94] tracking-[-0.055em] text-white drop-shadow-[0_6px_30px_rgba(0,0,0,.55)]"
      >
        {siteConfig.name}
      </h1>

      <p class="mt-4 font-mono text-[11.5px] tracking-[0.26em] text-white/70 sm:text-[12.5px]">
        FULL-STACK ENGINEER · AI PRODUCTS
      </p>

      <p class="mt-5 max-w-lg text-[15px] leading-relaxed text-white/72 sm:text-[16px]">
        把大模型能力做成能上线的产品。后端 Python/FastAPI 与 Go，前端 Vue3/React 与
        Flutter；做过流式对话、多租户鉴权、异步任务与 LLM 结构化输出。
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-3 text-[14px] font-semibold text-[#1a1204] shadow-[0_16px_40px_-16px_rgba(255,197,61,.9)] transition hover:-translate-y-0.5 hover:bg-[#ffd166]"
          href={`mailto:${siteConfig.social.email}`}
        >
          发封邮件
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            ><path d="M5 12h14M13 6l6 6-6 6" /></svg
          >
        </a>
        <a
          class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/5 px-5 py-3 text-[14px] font-medium text-white/90 backdrop-blur-md transition hover:border-white/50 hover:bg-white/10"
          href="#projects"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            ><path d="M8 5v14l11-7z" /></svg
          >
          看看项目
        </a>
      </div>
    </div>
  </div>

  <!-- 滚动引导 -->
  <a
    href="#about"
    class="scroll-hint absolute bottom-8 right-6 hidden items-center gap-2 font-mono text-[10.5px] tracking-[0.22em] text-white/55 transition hover:text-white sm:right-10 sm:flex lg:right-16"
  >
    SCROLL TO EXPLORE
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
      ><path d="M12 5v14M6 13l6 6 6-6" /></svg
    >
  </a>
</section>

<!-- 技术跑马灯 -->
<div class="marquee border-b border-line py-3.5">
  <div class="marquee-track font-mono text-[11.5px] uppercase tracking-[0.2em] text-dim">
    {stack.map((s) => <span>{s}</span>)}
    {stack.map((s) => <span aria-hidden="true">{s}</span>)}
  </div>
</div>
