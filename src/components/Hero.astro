---
import { siteConfig } from "../config";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const stack = [
  "Python",
  "FastAPI",
  "Go",
  "Vue 3",
  "TypeScript",
  "React",
  "Flutter",
  "PostgreSQL",
  "Redis",
  "Docker",
  "Kubernetes",
  "LLM",
];
---

<section
  id="top"
  class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden pb-10 pt-24 lg:pt-28"
>
  <!-- 光 -->
  <div
    class="glow right-[4%] top-[10%] h-[560px] w-[560px] lg:right-[8%] lg:h-[720px] lg:w-[720px]"
    style="background: radial-gradient(circle, rgba(255,197,61,.26), rgba(255,140,30,.08) 46%, transparent 72%)"
  >
  </div>
  <div
    class="glow -left-40 bottom-0 h-[420px] w-[420px]"
    style="background: radial-gradient(circle, rgba(79,209,224,.12), transparent 66%)"
  >
  </div>

  <!-- 网格 -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-[0.12]"
    style="background-image:linear-gradient(rgba(255,255,255,.07) 1px, transparent 1px),linear-gradient(90deg, rgba(255,255,255,.07) 1px, transparent 1px); background-size:72px 72px; mask-image:radial-gradient(70% 62% at 62% 42%, #000, transparent 78%)"
  >
  </div>

  <!-- 贴纸 -->
  <div
    class="absolute right-6 top-24 z-20 hidden rotate-3 rounded-lg border border-white/20 bg-white/[0.06] px-3 py-2 font-mono text-[10.5px] tracking-[0.16em] text-white/75 backdrop-blur-md sm:right-10 sm:top-28 lg:right-14 lg:block"
  >
    2026 · OPEN TO WORK
  </div>

  <div
    class="relative z-10 mx-auto grid w-full max-w-6xl items-center gap-4 px-6 lg:grid-cols-[1.02fr_0.98fr] lg:gap-8 lg:px-8"
  >
    <!-- 3D 分身卡 -->
    <figure
      class="avatar-wrap order-1 relative mx-auto w-full max-w-[300px] sm:max-w-[340px] lg:order-2 lg:mx-0 lg:max-w-[400px]"
    >
      <!-- 背后光 -->
      <div
        class="pointer-events-none absolute -inset-8 -z-10 rounded-[40px] opacity-90"
        style="background: radial-gradient(circle at 50% 42%, rgba(255,197,61,.22), rgba(255,150,40,.06) 55%, transparent 72%); filter: blur(14px)"
      >
      </div>

      <div
        id="avatar-card"
        class="avatar-tilt relative overflow-hidden rounded-[24px] border border-white/12 bg-[#0d1016] shadow-[0_40px_90px_-40px_rgba(0,0,0,.95)]"
      >
        <img
          src={`${base}/avatar-card.jpg`}
          width="640"
          height="816"
          alt="张雨的 3D 卡通分身：戴头盔、黄色雪服、踩着单板"
          class="block aspect-[3/4] w-full object-cover object-top"
          fetchpriority="high"
        />
        <!-- 让渲染图融进深色卡片 -->
        <div
          class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(7,8,11,.35),transparent_28%,transparent_62%,rgba(7,8,11,.85))]"
        >
        </div>
        <div class="absolute left-3.5 top-3.5 flex items-center gap-1.5">
          <span class="rounded-md bg-black/45 px-2 py-1 font-mono text-[9.5px] tracking-[0.16em] text-white/75 backdrop-blur-md"
            >3D AVATAR</span
          >
        </div>
      </div>

      <figcaption
        class="mt-3 text-center font-mono text-[10px] tracking-[0.2em] text-dim lg:text-left"
      >
        MOVE YOUR CURSOR
      </figcaption>
    </figure>

    <!-- 文案 -->
    <div class="hero-fade order-2 lg:order-1">
      <p class="font-mono text-[11px] tracking-[0.24em] text-dim">
        39.9°N 116.4°E · BEIJING
      </p>

      <h1
        class="mt-2 text-[clamp(3.2rem,9vw,6.4rem)] font-extrabold leading-[0.9] tracking-[-0.05em]"
      >
        {siteConfig.name}
      </h1>

      <p class="mt-3 font-mono text-[11.5px] tracking-[0.26em] text-muted sm:text-[12.5px]">
        FULL-STACK ENGINEER · AI PRODUCTS
      </p>

      <p class="mt-5 max-w-md text-[14.5px] leading-relaxed text-muted sm:text-[15.5px]">
        把大模型能力做成能上线的产品。后端 Python/FastAPI 与 Go，前端 Vue3/React 与
        Flutter；做过流式对话、多租户鉴权、异步任务与 LLM 结构化输出。
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a
          class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-3 text-[14px] font-semibold text-[#1a1204] shadow-[0_16px_40px_-16px_rgba(255,197,61,.9)] transition hover:-translate-y-0.5 hover:bg-[#ffd166]"
          href={`mailto:${siteConfig.social.email}`}
        >
          发封邮件
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            ><path d="M5 12h14M13 6l6 6-6 6" /></svg
          >
        </a>
        <a
          class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/[0.04] px-5 py-3 text-[14px] font-medium text-white/85 backdrop-blur-md transition hover:border-white/40 hover:bg-white/10"
          href="#projects"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            ><path d="M8 5v14l11-7z" /></svg
          >
          看看项目
        </a>
      </div>

      <dl class="mt-9 flex gap-8 border-t border-line pt-5">
        <div>
          <dt class="font-mono text-[18px] font-semibold">
            3<span class="ml-0.5 text-[11px] text-dim">段</span>
          </dt>
          <dd class="text-[11px] text-dim">工作经历</dd>
        </div>
        <div>
          <dt class="font-mono text-[18px] font-semibold">
            7<span class="ml-0.5 text-[11px] text-dim">个月</span>
          </dt>
          <dd class="text-[11px] text-dim">企业级交付</dd>
        </div>
        <div>
          <dt class="font-mono text-[18px] font-semibold">
            Top <span class="text-[11px] text-dim">5%</span>
          </dt>
          <dd class="text-[11px] text-dim">专业排名</dd>
        </div>
      </dl>
    </div>
  </div>

  <a
    href="#about"
    class="absolute bottom-6 right-6 z-20 hidden items-center gap-2 font-mono text-[10.5px] tracking-[0.22em] text-dim transition hover:text-text sm:right-10 sm:flex lg:right-14"
  >
    SCROLL TO EXPLORE
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
      ><path d="M12 5v14M6 13l6 6 6-6" /></svg
    >
  </a>
</section>

<!-- 技术跑马灯 -->
<div class="marquee border-y border-line py-3.5">
  <div class="marquee-track font-mono text-[11.5px] uppercase tracking-[0.2em] text-dim">
    {stack.map((s) => <span>{s}</span>)}
    {stack.map((s) => <span aria-hidden="true">{s}</span>)}
  </div>
</div>

<script>
  const img = document.getElementById("avatar-card") as HTMLElement | null;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (img && !reduce) {
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;

    const tick = () => {
      raf = 0;
      cx += (tx - cx) * 0.08;
      cy += (ty - cy) * 0.08;
      img.style.transform =
        `perspective(1000px) rotateX(${(-cy * 5).toFixed(2)}deg) ` +
        `rotateY(${(cx * 9).toFixed(2)}deg) ` +
        `translate3d(${(cx * 10).toFixed(1)}px, ${(cy * 8).toFixed(1)}px, 0)`;
      if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) raf = requestAnimationFrame(tick);
    };

    const onMove = (e: PointerEvent) => {
      tx = (e.clientX / window.innerWidth) * 2 - 1;
      ty = (e.clientY / window.innerHeight) * 2 - 1;
      if (!raf) raf = requestAnimationFrame(tick);
    };

    window.addEventListener("pointermove", onMove, { passive: true });

    // 离开窗口时回正
    window.addEventListener("pointerleave", () => {
      tx = 0; ty = 0;
      if (!raf) raf = requestAnimationFrame(tick);
    });
  }
</script>
