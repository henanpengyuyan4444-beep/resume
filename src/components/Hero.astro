---
import { siteConfig } from "../config";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const stack = [
  "Python",
  "FastAPI",
  "Go",
  "Vue 3",
  "TypeScript",
  "React",
  "Flutter",
  "PostgreSQL",
  "Redis",
  "Docker",
  "Kubernetes",
  "LLM",
];
---

<section class="relative isolate overflow-hidden pb-14 pt-24 sm:pt-28 lg:pb-20 lg:pt-32">
  <div
    class="glow -right-32 top-0 h-[520px] w-[520px]"
    style="background: radial-gradient(circle, rgba(255,197,61,.26), transparent 65%)"
  >
  </div>
  <div
    class="glow -left-40 bottom-0 h-[420px] w-[420px]"
    style="background: radial-gradient(circle, rgba(79,209,224,.16), transparent 65%)"
  >
  </div>

  <div
    class="mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-[1.04fr_0.96fr] lg:grid-rows-[auto_auto] lg:items-center lg:gap-x-16 lg:gap-y-12 lg:px-8"
  >
    <!-- 文案 -->
    <div class="reveal lg:col-start-1 lg:row-start-1">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-line bg-white/[0.03] px-3 py-1.5 text-[12.5px] text-muted"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[#3ddc97] shadow-[0_0_0_4px_rgba(61,220,151,.14)]"></span>
        {siteConfig.status}
      </p>

      <h1
        class="mt-6 text-[clamp(3.1rem,8.4vw,6.4rem)] font-extrabold leading-[0.92] tracking-[-0.045em]"
      >
        {siteConfig.name}
      </h1>

      <p class="mt-5 text-xl font-semibold sm:text-2xl">
        全栈开发工程师
        <span class="text-dim">/ AI 应用方向</span>
      </p>

      <p class="mt-5 max-w-[34rem] text-[15px] leading-relaxed text-muted sm:text-[15.5px]">
        把大模型能力做成<strong class="font-semibold text-text">能上线的产品</strong>：后端
        Python/FastAPI 与 Go，前端 Vue3/React 与 Flutter；做过流式对话、多租户鉴权、异步任务与
        LLM 结构化输出。
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a class="btn btn-primary" href={`mailto:${siteConfig.social.email}`}>
          发封邮件
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            ><path d="M5 12h14M13 6l6 6-6 6" /></svg
          >
        </a>
        <a class="btn" href="#experience">看看经历</a>
        <a
          class="inline-flex items-center gap-1.5 font-mono text-[12.5px] text-dim transition-colors hover:text-text"
          href={`tel:${siteConfig.phone}`}
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            ><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg
          >
          {siteConfig.phone}
        </a>
      </div>
    </div>

    <!-- 照片 -->
    <figure
      class="reveal relative mx-auto w-full max-w-[300px] sm:max-w-[360px] lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:max-w-none"
    >
      <div class="portrait-frame">
        <div class="portrait aspect-[3/4]">
          <img
            src={`${base}/portrait.jpg`}
            srcset={`${base}/portrait-sm.jpg 480w, ${base}/portrait.jpg 900w`}
            sizes="(min-width: 1024px) 460px, 90vw"
            width="900"
            height="1200"
            alt="张雨在雪场，手持单板"
            fetchpriority="high"
          />
        </div>
      </div>

      <figcaption
        class="absolute -bottom-3 left-3 right-3 flex items-center justify-between gap-3 rounded-xl border border-line bg-ink/80 px-3.5 py-2.5 backdrop-blur-md lg:-bottom-4 lg:left-4 lg:right-4 lg:px-4 lg:py-3"
      >
        <span class="text-[12.5px] font-medium lg:text-[13px]">{siteConfig.location} · 2026 届</span>
        <span class="font-mono text-[10.5px] text-dim lg:text-[11px]">READY TO SHIP</span>
      </figcaption>
    </figure>

    <!-- 指标 -->
    <dl
      class="reveal grid max-w-md grid-cols-3 gap-6 border-t border-line pt-6 lg:col-start-1 lg:row-start-2"
    >
      <div>
        <dt class="font-mono text-[22px] font-semibold tracking-tight">3</dt>
        <dd class="mt-1 text-xs text-dim">段工作经历</dd>
      </div>
      <div>
        <dt class="font-mono text-[22px] font-semibold tracking-tight">
          7<span class="ml-0.5 text-[13px] text-muted">个月</span>
        </dt>
        <dd class="mt-1 text-xs text-dim">企业级项目交付</dd>
      </div>
      <div>
        <dt class="font-mono text-[22px] font-semibold tracking-tight">
          Top <span class="ml-0.5 text-[13px] text-muted">5%</span>
        </dt>
        <dd class="mt-1 text-xs text-dim">专业排名</dd>
      </div>
    </dl>
  </div>

  <!-- 技术跑马灯 -->
  <div class="marquee mt-14 border-y border-line py-4 lg:mt-16">
    <div class="marquee-track font-mono text-[12.5px] uppercase tracking-[0.18em] text-dim">
      {stack.map((s) => <span>{s}</span>)}
      {stack.map((s) => <span aria-hidden="true">{s}</span>)}
    </div>
  </div>
</section>
