---
import { siteConfig } from "../config";
const edu = siteConfig.education[0];
---

<section id="education" class="relative py-24 lg:py-32">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <p class="eyebrow reveal">04 — 教育</p>

    <div class="mt-10 grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
      <h2
        class="reveal text-[clamp(1.85rem,3.5vw,2.85rem)] font-bold leading-[1.18] tracking-[-0.02em]"
      >
        基础与奖项
      </h2>

      <div class="reveal">
        <div class="card p-6 sm:p-7">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h3 class="text-[17px] font-semibold sm:text-[19px]">{edu.school}</h3>
            <span class="font-mono text-[12px] text-dim">{edu.dateRange}</span>
          </div>
          <p class="mt-1 text-[14px] text-muted">{edu.degree}</p>

          <div class="mt-6 border-t border-line pt-5">
            <ul class="grid gap-2.5 sm:grid-cols-2">
              {edu.achievements.map((a) => (
                <li class="flex gap-2.5 text-[13.5px] text-muted">
                  <span class="mt-[8px] h-1 w-1 shrink-0 rounded-full bg-accent/70" />
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <p class="mt-4 text-[12.5px] leading-relaxed text-dim">
          课程方向：机器学习、数据结构、计算机网络、操作系统、数据库。
        </p>
      </div>
    </div>
  </div>
</section>
