---
import { siteConfig } from "../config";
---

<section id="projects" class="relative py-24 lg:py-32">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <p class="eyebrow reveal">03 — 项目</p>

    <div class="mt-10 flex flex-wrap items-end justify-between gap-6">
      <h2
        class="reveal max-w-2xl text-[clamp(1.85rem,3.5vw,2.85rem)] font-bold leading-[1.18] tracking-[-0.02em]"
      >
        四个项目，拆开看难点
      </h2>
      <p class="reveal max-w-sm text-[13px] leading-relaxed text-dim">
        每个项目都按「难在哪 → 怎么做 → 结果」写，而不是堆技术名词。
      </p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {
        siteConfig.projects.map((p, i) => (
          <article
            class="proj-card card reveal p-6 sm:p-7"
            data-spotlight
            style="--mx:50%;--my:0%"
          >
            <div class="flex items-center justify-between">
              <span class="font-mono text-[11px] tracking-[0.16em] text-dim">
                0{i + 1}
              </span>
              <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-accent/70">
                project
              </span>
            </div>

            <h3 class="mt-5 text-[18px] font-semibold leading-snug tracking-tight sm:text-[20px]">
              {p.name}
            </h3>

            <p class="mt-3 text-[14px] leading-[1.8] text-muted">{p.description}</p>

            <div class="mt-6 flex flex-wrap gap-1.5">
              {p.skills.map((s) => (
                <span class="rounded-md bg-white/[0.05] px-2 py-1 font-mono text-[11px] text-muted">
                  {s}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
