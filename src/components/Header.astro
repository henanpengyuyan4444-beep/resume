---
import { siteConfig } from "../config";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header
  id="header"
  class="no-print fixed inset-x-0 top-0 z-50 transition-all duration-300"
>
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 lg:px-8"
  >
    <a href={`${base}/`} class="group flex items-center gap-2 font-semibold tracking-tight">
      <span
        class="grid h-7 w-7 place-items-center rounded-lg bg-gradient-to-br from-accent to-[#ff9f1c] text-[13px] font-bold text-[#1a1204]"
        >张</span
      >
      <span class="text-[15px]">{siteConfig.name}</span>
      <span class="text-accent">.</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="页面导航">
      <a
        href="#about"
        data-nav
        class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:text-text"
        >关于</a
      >
      <a
        href="#experience"
        data-nav
        class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:text-text"
        >经历</a
      >
      <a
        href="#projects"
        data-nav
        class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:text-text"
        >项目</a
      >
      <a
        href="#contact"
        data-nav
        class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:text-text"
        >联系</a
      >
    </nav>

    <a
      class="btn !px-3.5 !py-2 text-[13px]"
      href={`${base}/resume.pdf`}
      target="_blank"
      rel="noopener"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        ><path d="M12 3v12m0 0 4-4m-4 4-4-4" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"
        /></svg
      >
      简历 PDF
    </a>
  </div>
</header>
