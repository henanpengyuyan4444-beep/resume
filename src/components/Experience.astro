---
import { siteConfig } from "../config";
---

<section id="experience" class="relative py-24 lg:py-32">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <p class="eyebrow reveal">02 — 经历</p>

    <div class="mt-10 flex flex-wrap items-end justify-between gap-6">
      <h2
        class="reveal max-w-2xl text-[clamp(1.85rem,3.5vw,2.85rem)] font-bold leading-[1.18] tracking-[-0.02em]"
      >
        让 AI 功能真的跑在业务里
      </h2>
      <p class="reveal text-[13px] text-dim">2025.09 — 至今 · 3 段</p>
    </div>

    <div class="mt-12 space-y-4">
      {
        siteConfig.experience.map((job, i) => (
          <article class="reveal grid gap-5 border-t border-line pt-8 md:grid-cols-[150px_1fr] md:gap-10">
            <div class="md:pt-1">
              <p class="font-mono text-[12px] tracking-wide text-dim">{job.dateRange}</p>
              <p class="mt-2 text-[13.5px] font-semibold text-accent">{job.company}</p>
            </div>

            <div class="card p-6 transition-colors hover:border-line-strong sm:p-7">
              <h3 class="text-[17px] font-semibold tracking-tight sm:text-[19px]">{job.title}</h3>
              <ul class="mt-4 space-y-2.5">
                {job.bullets.map((b) => (
                  <li class="flex gap-3 text-[14.5px] leading-relaxed text-muted">
                    <span class="mt-[9px] h-1 w-1 shrink-0 rounded-full bg-accent/70" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
